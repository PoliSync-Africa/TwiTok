{
  "expo": {
    "name": "TwiTok",
    "slug": "twitok",
    "version": "0.1.0",
    "scheme": "twitok",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/twitok-logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.twitokapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.twitokapp"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "49a4aa29-6266-437e-8423-7505caa46dd9"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/twitok-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/twitok-logo.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TwiTok to access your photos and videos.",
          "cameraPermission": "Allow TwiTok to use your camera.",
          "microphonePermission": "Allow TwiTok to record audio and video."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow TwiTok to record voice comments.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TwiTok to use your camera to create videos.",
          "microphonePermission": "Allow TwiTok to record audio with your videos.",
          "recordAudioAndroid": true
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow TwiTok to use your camera for LIVE video.",
          "microphonePermission": "Allow TwiTok to use your microphone for LIVE audio."
        }
      ]
    ]
  }
}
