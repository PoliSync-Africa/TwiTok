# TwiTok API
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
ADMIN_WEB_ORIGIN=http://localhost:3000
ALLOWED_WEB_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=twitok

# Owner authentication
OWNER_SESSION_SECRET=
TWITOK_OWNER_EMAIL=
TWITOK_OWNER_NAME=
TWITOK_OWNER_PASSWORD_HASH=
TWITOK_OWNER_MFA_ENABLED=false
TWITOK_OWNER_MFA_SECRET=
TWITOK_INTERNAL_SERVICE_KEY=

# User authentication
TWITOK_USER_SESSION_SECRET=

# Admin web
TWITOK_API_URL=http://localhost:4000

# Media / S3-compatible storage (Cloudflare R2, AWS S3, MinIO, etc.)
MEDIA_BUCKET=
MEDIA_PUBLIC_BASE_URL=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=false

# Realtime
WEBSOCKET_URL=

OPENAI_API_KEY=
TWITOK_STT_PROVIDER=openai
TWITOK_STT_MODEL=gpt-4o-mini-transcribe

TWITOK_TRANSLATION_PROVIDER=openai
TWITOK_TRANSLATION_MODEL=gpt-5.6-luna
TWITOK_TRANSLATION_WORKER_ID=
TWITOK_TRANSLATION_WORKER_POLL_MS=3000

# Server-controlled USD payout rates, e.g. {"USD_GHS":12.0,"USD_NGN":1500}
TWITOK_FX_RATES_JSON={}

# Monetization / IAP
REVENUECAT_WEBHOOK_AUTH=

# Creator payouts
PAYSTACK_SECRET_KEY=
TWITOK_PAYSTACK_COLLECTION_FEE_BPS=
TWITOK_PAYSTACK_COLLECTION_TAX_BPS=0
TWITOK_USD_GHS_RATE=
TWITOK_PAYSTACK_CALLBACK_URL=
TWITOK_FLUTTERWAVE_SECRET_KEY=
TWITOK_FLUTTERWAVE_WEBHOOK_SECRET=
REVENUECAT_APP_ID=
REVENUECAT_WEBHOOK_ENVIRONMENT=PRODUCTION
TWITOK_FLUTTERWAVE_PAYOUT_CALLBACK_URL=
TWITOK_FLUTTERWAVE_PAYMENT_OPTIONS=card,mobilemoney,banktransfer,ussd
